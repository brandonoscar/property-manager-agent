VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to "true" to bypass the login screen with a fake demo user.
# You can also append ?demo=1 to the URL at runtime without redeploying.
VITE_DEMO_MODE=false

# PostHog analytics (get from https://us.posthog.com → Project Settings).
# Leave VITE_PUBLIC_POSTHOG_KEY blank to disable analytics.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking. Leave VITE_SENTRY_DSN blank to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# The PUBLIC origin of THIS deployment's backend — scheme + host, no path.
#
# ⚠ This is the one value here whose blank is not a safe default. It builds
# the webhook URL the customer copies into Buildium (Settings → Connectors →
# Buildium), and `/webhooks/*` is NOT covered by vercel.json's
# `/api/*` rewrite, so Buildium must POST straight at the backend host.
# Left unset, the app falls back to a hardcoded hostname that belongs to
# Occupella's own production deployment — so a second deployment (staging,
# self-hosted, white-label) hands its customer a URL pointing at somebody
# else's backend. Nothing reports that on either side: the receiver does not
# recognise the AccountId and returns 200 (see `webhooks/router.py`), and the
# sending deployment's panel simply shows no events arriving.
#
# ⚠ Vite inlines this at BUILD time, so a stale value in the Vercel dashboard
# beats whatever is here (CLAUDE.md gotcha 3). Change it in the dashboard and
# redeploy — editing this file alone changes nothing that ships.
VITE_RENDER_BACKEND_URL=https://your-backend.onrender.com
