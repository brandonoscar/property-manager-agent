# Occupella environment (package name: helixis)
# Copy to .env and fill in your own values. Nothing here is shared: you bring
# your own keys, your own Supabase project and your own Render (or Docker) host.
# SELF-HOSTING.md says which keys are required and what each optional one turns on.

# Encryption key for secrets stored in the database (each company's PMS keys).
# REQUIRED before anyone connects a PMS. Generate once and keep it: there is no
# re-encrypt path, so changing it makes every stored PMS key unreadable.
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
HELIXIS_DATA_KEY=

# LLM API Keys
HELIXIS_LLM__OPENAI_API_KEY=sk-...
HELIXIS_LLM__ANTHROPIC_API_KEY=sk-ant-...
# Voyage AI — memory embedder (Anthropic has no embeddings API)
HELIXIS_LLM__VOYAGE_API_KEY=pa-...

# Composio
HELIXIS_COMPOSIO__API_KEY=your-composio-key

# Supabase (pgvector for Mem0)
HELIXIS_SUPABASE__URL=https://your-project.supabase.co
HELIXIS_SUPABASE__ANON_KEY=your-anon-key
HELIXIS_SUPABASE__SERVICE_KEY=your-service-key
HELIXIS_SUPABASE__DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Authentication (Supabase JWT secret — from dashboard Settings > API)
HELIXIS_AUTH__JWT_SECRET=your-supabase-jwt-secret

# API
HELIXIS_API__HOST=0.0.0.0
HELIXIS_API__PORT=8000
HELIXIS_API__CORS_ORIGINS=["http://localhost:5173"]
# Where invite and password-reset emails send people (your frontend's URL).
HELIXIS_API__PUBLIC_APP_URL=http://localhost:5173

# Browser Automation (Browserbase)
HELIXIS_BROWSER__BROWSERBASE_API_KEY=
HELIXIS_BROWSER__BROWSERBASE_PROJECT_ID=

# Langfuse Observability — leave keys blank to disable tracing
HELIXIS_LANGFUSE__ENABLED=true
HELIXIS_LANGFUSE__PUBLIC_KEY=
HELIXIS_LANGFUSE__SECRET_KEY=
HELIXIS_LANGFUSE__HOST=http://localhost:3000
# Mask LLM prompt/completion CONTENT before it reaches Langfuse Cloud (traces
# keep structure/latency/tokens; message text is redacted). Default false while
# dogfooding on synthetic data. ⚠ SET true BEFORE the first real property
# manager connects, or raw tenant PII ships to a third party (audit Q25).
HELIXIS_LANGFUSE__MASK_GENERATION_CONTENT=false

# PostHog product analytics — leave project_api_key blank to disable
HELIXIS_POSTHOG__ENABLED=true
HELIXIS_POSTHOG__PROJECT_API_KEY=
HELIXIS_POSTHOG__HOST=https://us.i.posthog.com

# Sentry error tracking — leave DSN blank to disable
HELIXIS_SENTRY__ENABLED=true
HELIXIS_SENTRY__DSN=

# Buildium (sandbox by default; switch to https://api.buildium.com for prod)
HELIXIS_BUILDIUM__BASE_URL=https://apisandbox.buildium.com
HELIXIS_BUILDIUM__CLIENT_ID=
HELIXIS_BUILDIUM__CLIENT_SECRET=
HELIXIS_BUILDIUM__WEBHOOK_SECRET=
HELIXIS_BUILDIUM__ACCOUNT_ID=

# Email ingest (Gmail → Inbox). Read by the webhook WORKER. See CLAUDE.md §4
# "Email ingest". Both default OFF.
#   ENABLED            — turn the 120s Gmail poll on.
#   ALLOW_ALL_SENDERS  — TESTING ONLY: drop the known-Buildium-contact gate
#                        (length still applies) to validate the chain without a
#                        Buildium key. Leave OFF in prod.
HELIXIS_EMAIL_INGEST_ENABLED=false
HELIXIS_EMAIL_INGEST_ALLOW_ALL_SENDERS=false

# Reconciliation Phase-2 analyst (worker): nightly LLM cross-examination of
# each company's mirrored books → source='analyst' risk flags. Phase-1 rules
# are always on (pure SQL); this flag only gates the LLM pass. Default OFF —
# dogfood on our own books before any customer's.
HELIXIS_RECON__ANALYST_ENABLED=false

# Developer affordances (PR #141 — Trust series #1)
# /dev/runs is the orchestrator-run telemetry inspection page.
# Defaults to ``true`` in development (config/default.yaml),
# ``false`` in production (config/production.yaml). Override here
# to flip it the other way locally.
HELIXIS_DEV__SHOW_RUNS_PAGE=true

# CRM (lead pipeline). Default OFF → the section is "Coming soon" and the
# /crm/* routes 404. Flip on once leads + Twilio are wired. Apply migrations
# 0028_crm_leads.sql + 0029_crm_lead_messages.sql + 0030_crm_lead_draft.sql
# first (no runner — §4).
HELIXIS_CRM__ENABLED=false
# Worker flag: turn the Gmail → CRM lead poll on (needs the CRM master flag
# too). The webhook worker then polls each Gmail-connected user every 120s and
# turns inquiry-shaped emails from NEW senders into leads. Also gates the
# keyless POST /crm/email/simulate test route. Default OFF (dark until a deploy
# flips it). Rides the existing Gmail (Composio) connection — no new secrets.
HELIXIS_CRM__EMAIL_INGEST_ENABLED=false

# Twilio SMS — the texting channel for CRM leads. Inbound texts hit
# POST /crm/sms/inbound (signature-verified with AUTH_TOKEN); replies are
# sent from FROM_NUMBER via the REST API. All blank → SMS paths stay dark.
# To go live: create a Twilio number, point its "A message comes in" webhook
# at https://<backend>/api/v1/crm/sms/inbound, and (US) complete A2P 10DLC.
HELIXIS_TWILIO__ACCOUNT_SID=
HELIXIS_TWILIO__AUTH_TOKEN=
HELIXIS_TWILIO__FROM_NUMBER=
# Outbound customer-care SMS (comms/sms.py — A2P 10DLC campaign: rent
# reminders, maintenance updates, appointment confirmations). DARK by
# default; flip to true only once carriers approve the campaign. Sends are
# templates-only, require a helixis_sms_consent row, and respect the TCPA
# 08:00-21:00 recipient-local quiet-hours window.
HELIXIS_TWILIO__ENABLED=false
# Optional alternative sender to FROM_NUMBER: an A2P Messaging Service SID
# (MG...). When set, outbound sends go via the Messaging Service and Twilio
# picks the number from its pool.
HELIXIS_TWILIO__MESSAGING_SERVICE_SID=
# The PUBLIC backend origin Twilio calls back for the customer-care SMS
# webhooks (e.g. https://your-api.onrender.com — no trailing slash).
# Non-empty → sends request delivery receipts (StatusCallback →
# {base}/api/v1/twilio/status) and the inbound/status endpoints verify
# X-Twilio-Signature against {base}{path}. ⚠ Must match EXACTLY what the
# Twilio console has configured — the full URL participates in the HMAC
# signature. Empty → those endpoints 403 everything (fail closed).
HELIXIS_TWILIO__WEBHOOK_BASE_URL=
# v1 single-number → company routing: which company an inbound text belongs
# to (resolved from the number it was sent TO). Set to a company UUID.
HELIXIS_TWILIO__DEFAULT_COMPANY_ID=
# Voice (call intake). A call to the Twilio number logs the lead by caller
# number, then FORWARDS to FORWARD_TO_NUMBER (the PM's cell). A missed call
# falls through to voicemail (recorded + attached to the lead). Point the
# number's "A call comes in" Voice webhook at
# https://<backend>/api/v1/crm/voice/inbound. Blank FORWARD_TO_NUMBER → every
# call goes straight to voicemail (no forward).
HELIXIS_TWILIO__FORWARD_TO_NUMBER=
# Optional custom voicemail greeting (a sensible default is used when blank).
HELIXIS_TWILIO__VOICE_GREETING=
# Seconds to ring the PM's cell before falling through to voicemail.
HELIXIS_TWILIO__DIAL_TIMEOUT_SECONDS=20
# TESTING ONLY — skip inbound signature verification so /crm/sms/simulate,
# /crm/voice/simulate (and local Twilio-console tests) work without a signed
# request. NEVER true in prod: an unsigned inbound could spoof leads.
HELIXIS_TWILIO__SKIP_SIGNATURE_CHECK=false

# Billing (Stripe subscriptions)
# ⚠ NOTHING HERE NAMED STRIPE UNTIL 2026-09-05, so the go-live configuration
# list did not exist: whoever set Render up had to read settings.py to learn
# which values to paste. Every failure below is quiet, which is why they are
# spelled out rather than left to be discovered.
#
# The secret key and the webhook secret together are `billing.configured`.
# Without them /billing/checkout 503s and the webhook 403s EVERY event —
# deliberately, since that endpoint decides who has paid.
HELIXIS_BILLING__STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint, pointing at
# https://<backend>/api/v1/billing/webhook. ⚠ It differs per endpoint AND
# between test and live mode; a stale one rejects every event with a 403 and
# our billing rows silently stop tracking reality.
HELIXIS_BILLING__STRIPE_WEBHOOK_SECRET=
# One Stripe price id per purchasable plan. ⚠ An EMPTY one makes that plan
# unbuyable — checkout refuses rather than sending Stripe a blank price — so a
# deploy that forgets `price_scale` 503s only for the customer who picks the
# top plan, and only at the moment they try to pay. They must be RECURRING
# prices in the same mode as the secret key above; the daily smoke's `stripe`
# check reads each one back and fails if it is missing, archived, or priced
# differently from what the plan card shows the customer.
HELIXIS_BILLING__PRICE_STARTER=
HELIXIS_BILLING__PRICE_PRO=
HELIXIS_BILLING__PRICE_SCALE=
# THE LOCKOUT, and a separate question from having keys (gotcha 67 is this
# repo's record of one flag being read as answering two). False = billing is
# wired and metered but nobody is turned away. Flip it deliberately, after
# watching the usage meter.
HELIXIS_BILLING__ENFORCE=false
# Where Stripe's billing portal returns the customer to. Blank falls back to
# the app's base URL.
HELIXIS_BILLING__PORTAL_RETURN_URL=

# Property management connectors. Each company pastes its OWN PMS keys in the
# app (Connectors page); they are stored encrypted with HELIXIS_DATA_KEY. These
# switches turn a connector on for the whole deployment. Buildium is always on.
HELIXIS_RENTVINE__ENABLED=false
HELIXIS_RENTMANAGER__ENABLED=false
HELIXIS_RENTMANAGER__WRITES_ENABLED=false
HELIXIS_PROPERTYWARE__ENABLED=false
HELIXIS_PROPERTYWARE__WRITES_ENABLED=false
HELIXIS_DOORLOOP__ENABLED=false
HELIXIS_DOORLOOP__WRITES_ENABLED=false

# Environment
HELIXIS_ENV=development
